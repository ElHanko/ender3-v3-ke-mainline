#
# Greenlet 3.1.1 uses designated initializers for two PyTypeObject instances
# and one PyNumberMethods instance. GCC 7 accepts the other initializers in
# this source, but rejects these non-trivial objects in C++ mode. Keep the
# static PyVarObject base initialization, initialize the remaining storage to
# zero, and set the original fields before PyType_Ready().
#
# Remove or reassess this GCC 7 compatibility patch when the external
# toolchain is upgraded, or when a Greenlet update no longer needs it.
diff --git a/src/greenlet/PyGreenlet.cpp b/src/greenlet/PyGreenlet.cpp
index 29c0bba..eb47939 100644
--- a/src/greenlet/PyGreenlet.cpp
+++ b/src/greenlet/PyGreenlet.cpp
@@ -697,39 +697,10 @@ static PyMemberDef green_members[] = {
     {.name=NULL}
 };
 
-static PyNumberMethods green_as_number = {
-  .nb_bool=(inquiry)green_bool,
-};
+static PyNumberMethods green_as_number = {};
 
 
-PyTypeObject PyGreenlet_Type = {
-    .ob_base=PyVarObject_HEAD_INIT(NULL, 0)
-    .tp_name="greenlet.greenlet", /* tp_name */
-    .tp_basicsize=sizeof(PyGreenlet),  /* tp_basicsize */
-    /* methods */
-    .tp_dealloc=(destructor)green_dealloc, /* tp_dealloc */
-    .tp_repr=(reprfunc)green_repr,      /* tp_repr */
-    .tp_as_number=&green_as_number,          /* tp_as _number*/
-    .tp_flags=G_TPFLAGS_DEFAULT | Py_TPFLAGS_BASETYPE, /* tp_flags */
-    .tp_doc="greenlet(run=None, parent=None) -> greenlet\n\n"
-    "Creates a new greenlet object (without running it).\n\n"
-    " - *run* -- The callable to invoke.\n"
-    " - *parent* -- The parent greenlet. The default is the current "
-    "greenlet.",                        /* tp_doc */
-    .tp_traverse=(traverseproc)green_traverse, /* tp_traverse */
-    .tp_clear=(inquiry)green_clear,         /* tp_clear */
-    .tp_weaklistoffset=offsetof(PyGreenlet, weakreflist),  /* tp_weaklistoffset */
-
-    .tp_methods=green_methods,                      /* tp_methods */
-    .tp_members=green_members,                      /* tp_members */
-    .tp_getset=green_getsets,                      /* tp_getset */
-    .tp_dictoffset=offsetof(PyGreenlet, dict),         /* tp_dictoffset */
-    .tp_init=(initproc)green_init,               /* tp_init */
-    .tp_alloc=PyType_GenericAlloc,                  /* tp_alloc */
-    .tp_new=(newfunc)green_new,                          /* tp_new */
-    .tp_free=PyObject_GC_Del,                   /* tp_free */
-    .tp_is_gc=(inquiry)green_is_gc,         /* tp_is_gc */
-};
+PyTypeObject PyGreenlet_Type = { PyVarObject_HEAD_INIT(NULL, 0) };
 
 #endif
 
diff --git a/src/greenlet/PyGreenletUnswitchable.cpp b/src/greenlet/PyGreenletUnswitchable.cpp
index 1b768ee..4619cab 100644
--- a/src/greenlet/PyGreenletUnswitchable.cpp
+++ b/src/greenlet/PyGreenletUnswitchable.cpp
@@ -125,23 +125,7 @@ static PyGetSetDef green_unswitchable_getsets[] = {
     {.name=nullptr}
 };
 
-PyTypeObject PyGreenletUnswitchable_Type = {
-    .ob_base=PyVarObject_HEAD_INIT(NULL, 0)
-    .tp_name="greenlet._greenlet.UnswitchableGreenlet",
-    .tp_dealloc= (destructor)green_dealloc, /* tp_dealloc */
-    .tp_flags=G_TPFLAGS_DEFAULT | Py_TPFLAGS_BASETYPE, /* tp_flags */
-    .tp_doc="Undocumented internal class",                        /* tp_doc */
-    .tp_traverse=(traverseproc)green_traverse, /* tp_traverse */
-    .tp_clear=(inquiry)green_clear,         /* tp_clear */
-
-    .tp_getset=green_unswitchable_getsets,                      /* tp_getset */
-    .tp_base=&PyGreenlet_Type,                                  /* tp_base */
-    .tp_init=(initproc)green_init,               /* tp_init */
-    .tp_alloc=PyType_GenericAlloc,                  /* tp_alloc */
-    .tp_new=(newfunc)green_unswitchable_new,                          /* tp_new */
-    .tp_free=PyObject_GC_Del,                   /* tp_free */
-    .tp_is_gc=(inquiry)green_is_gc,         /* tp_is_gc */
-};
+PyTypeObject PyGreenletUnswitchable_Type = { PyVarObject_HEAD_INIT(NULL, 0) };
 
 
 #endif
diff --git a/src/greenlet/greenlet.cpp b/src/greenlet/greenlet.cpp
index e8d92a0..607e159 100644
--- a/src/greenlet/greenlet.cpp
+++ b/src/greenlet/greenlet.cpp
@@ -213,6 +213,48 @@ greenlet_internal_mod_init() noexcept
     try {
         CreatedModule m(greenlet_module_def);
 
+        green_as_number.nb_bool = (inquiry)green_bool;
+
+        PyGreenlet_Type.tp_name = "greenlet.greenlet";
+        PyGreenlet_Type.tp_basicsize = sizeof(PyGreenlet);
+        PyGreenlet_Type.tp_dealloc = (destructor)green_dealloc;
+        PyGreenlet_Type.tp_repr = (reprfunc)green_repr;
+        PyGreenlet_Type.tp_as_number = &green_as_number;
+        PyGreenlet_Type.tp_flags = G_TPFLAGS_DEFAULT | Py_TPFLAGS_BASETYPE;
+        PyGreenlet_Type.tp_doc = "greenlet(run=None, parent=None) -> greenlet\n\n"
+            "Creates a new greenlet object (without running it).\n\n"
+            " - *run* -- The callable to invoke.\n"
+            " - *parent* -- The parent greenlet. The default is the current "
+            "greenlet.";
+        PyGreenlet_Type.tp_traverse = (traverseproc)green_traverse;
+        PyGreenlet_Type.tp_clear = (inquiry)green_clear;
+        PyGreenlet_Type.tp_weaklistoffset = offsetof(PyGreenlet, weakreflist);
+        PyGreenlet_Type.tp_methods = green_methods;
+        PyGreenlet_Type.tp_members = green_members;
+        PyGreenlet_Type.tp_getset = green_getsets;
+        PyGreenlet_Type.tp_dictoffset = offsetof(PyGreenlet, dict);
+        PyGreenlet_Type.tp_init = (initproc)green_init;
+        PyGreenlet_Type.tp_alloc = PyType_GenericAlloc;
+        PyGreenlet_Type.tp_new = (newfunc)green_new;
+        PyGreenlet_Type.tp_free = PyObject_GC_Del;
+        PyGreenlet_Type.tp_is_gc = (inquiry)green_is_gc;
+
+        PyGreenletUnswitchable_Type.tp_name =
+            "greenlet._greenlet.UnswitchableGreenlet";
+        PyGreenletUnswitchable_Type.tp_dealloc = (destructor)green_dealloc;
+        PyGreenletUnswitchable_Type.tp_flags =
+            G_TPFLAGS_DEFAULT | Py_TPFLAGS_BASETYPE;
+        PyGreenletUnswitchable_Type.tp_doc = "Undocumented internal class";
+        PyGreenletUnswitchable_Type.tp_traverse = (traverseproc)green_traverse;
+        PyGreenletUnswitchable_Type.tp_clear = (inquiry)green_clear;
+        PyGreenletUnswitchable_Type.tp_getset = green_unswitchable_getsets;
+        PyGreenletUnswitchable_Type.tp_base = &PyGreenlet_Type;
+        PyGreenletUnswitchable_Type.tp_init = (initproc)green_init;
+        PyGreenletUnswitchable_Type.tp_alloc = PyType_GenericAlloc;
+        PyGreenletUnswitchable_Type.tp_new = (newfunc)green_unswitchable_new;
+        PyGreenletUnswitchable_Type.tp_free = PyObject_GC_Del;
+        PyGreenletUnswitchable_Type.tp_is_gc = (inquiry)green_is_gc;
+
         Require(PyType_Ready(&PyGreenlet_Type));
         Require(PyType_Ready(&PyGreenletUnswitchable_Type));
 
