#
# Buildroot 2023.08.3 already disables libffi static executable trampolines for
# the target package, but the option is not inherited by the host package.
# host-libffi 3.4.4 otherwise fails with newer host compilers because tramp.c
# calls the internal open_temp_exec_file() without a visible declaration.
# Keep the host and target configurations aligned instead of patching libffi.
#
# Source: pinned Buildroot tree in the Ingenic X2000 SDK
# SDK commit: a98c2e1f22e4263ddd4153a4eca4db4dcfd2777b
diff --git a/buildroot/package/libffi/libffi.mk b/buildroot/package/libffi/libffi.mk
--- a/buildroot/package/libffi/libffi.mk
+++ b/buildroot/package/libffi/libffi.mk
@@ -18,5 +18,6 @@ LIBFFI_AUTORECONF = YES
 # libffi 3.4.2. However it doesn't work with gobject-introspection.
 LIBFFI_CONF_OPTS = --disable-exec-static-tramp
+HOST_LIBFFI_CONF_OPTS = --disable-exec-static-tramp

 $(eval $(autotools-package))
 $(eval $(host-autotools-package))
