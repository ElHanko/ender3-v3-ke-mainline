#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
persistence="$root/configs/x2000-develop/rootfs-overlay/etc/init.d/S10fre3nder-persistence"
tmp=$(mktemp -d)

cleanup() {
	rm -rf -- "$tmp"
}
trap cleanup EXIT HUP INT TERM

state=$tmp/state
persist_root=$tmp/persist
proc_mounts=$tmp/proc-mounts

run_persistence() {
	FRE3NDER_PERSISTENCE_STATE="$state" \
	FRE3NDER_PERSIST_ROOT="$persist_root" \
	FRE3NDER_PROC_MOUNTS="$proc_mounts" \
	"$persistence" "$1"
}

status_is() {
	[ "$(cat "$state/status")" = "$1" ]
}

# Both contract paths are required; no backend-specific discovery occurs here.
rm -rf -- "$state" "$persist_root" "$proc_mounts"
: > "$proc_mounts"
run_persistence start
status_is missing-persistence

rm -rf -- "$state" "$persist_root" "$proc_mounts"
mkdir -p "$persist_root/system"
: > "$proc_mounts"
run_persistence start
status_is missing-persistence

# The final layer creates only the required Fre3nder SSH directory structure.
rm -rf -- "$state" "$persist_root" "$proc_mounts"
mkdir -p "$persist_root/system" "$persist_root/userdata"
printf 'backend %s ext4 rw 0 0\n' "$persist_root/system" > "$proc_mounts"
printf 'backend %s ext4 rw 0 0\n' "$persist_root/userdata" >> "$proc_mounts"
run_persistence start
status_is active
[ -d "$persist_root/system/fre3nder/ssh" ]
[ ! -L "$persist_root/system/fre3nder" ]
[ ! -L "$persist_root/system/fre3nder/ssh" ]
[ "$(stat -c %a "$persist_root/system/fre3nder/ssh")" = 700 ]
[ -d "$persist_root/userdata" ]
[ "$(find "$persist_root/userdata" -mindepth 1 -print -quit)" = '' ]
run_persistence stop
status_is stopped

# The final layer must contain no Development backend terminology.
if rg -n -i 'x2000dev|fre3nderdata|usb|sd\[a-z\]|mmcblk0|p9|p10|rootfs_data' \
	"$persistence"; then
	echo 'final persistence contains Development storage knowledge' >&2
	exit 1
fi

echo 'fre3nder persistence fixture tests: PASS'
