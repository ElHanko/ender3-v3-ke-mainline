#!/usr/bin/env bash
set -Eeuo pipefail

die() {
	echo "REFUSED: $*" >&2
	exit 1
}

usage() {
	echo "usage: $0 HOST" >&2
	exit 2
}

[[ $# == 1 ]] || usage

host=$1
[[ -n $host && $host != -* ]] || usage

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
ab="$root/scripts/x2000-ab"
backup_root="$root/local/production/backup"

[[ -x $ab ]] ||
	die "scripts/x2000-ab is unavailable"

git -C "$root" check-ignore -q local/production ||
	die "local/production is not ignored by Git"

mkdir -p "$backup_root"

echo '=== PERSISTENT ROOT ==='

root_status=$(
	ssh -o BatchMode=yes "$host" \
		'cat /run/fre3nder-root/status 2>/dev/null'
) || die "cannot read Fre3nder persistent-root status"

printf '%s\n' "$root_status"

[[ $root_status == active ]] ||
	die "Fre3nder persistent root is not active"


echo
echo '=== HOME BACKUP ==='

timestamp=$(date +%Y%m%dT%H%M%S)
backup="$backup_root/home-$timestamp"
incomplete="$backup.incomplete"

[[ ! -e $backup && ! -e $incomplete ]] ||
	die "backup destination already exists"

mkdir -m 0700 "$incomplete"

cleanup_incomplete() {
	local status=$?

	trap - EXIT HUP INT TERM

	if [[ -d $incomplete ]]; then
		rm -rf -- "$incomplete"
	fi

	exit "$status"
}

trap cleanup_incomplete EXIT HUP INT TERM

ssh -o BatchMode=yes "$host" \
	'tar -C /home -cf - .' \
	> "$incomplete/home.tar" ||
	die "cannot create off-device /home backup"

[[ -s $incomplete/home.tar ]] ||
	die "/home backup archive is empty"

tar -tf "$incomplete/home.tar" \
	> "$incomplete/home.tar.list" ||
	die "/home backup archive verification failed"

(
	cd "$incomplete"
	sha256sum home.tar > home.tar.sha256
	sha256sum -c home.tar.sha256
) >/dev/null ||
	die "/home backup checksum verification failed"

printf '%s\n' COMPLETE \
	> "$incomplete/.fre3nder-backup-complete"

mv -- "$incomplete" "$backup"

trap - EXIT HUP INT TERM

echo "BACKUP_OK=${backup#$root/}"


echo
echo '=== SELECTOR SAFETY ==='

status=$("$ab" "$host" status) ||
	die "cannot determine X2000 selector state"

printf '%s\n' "$status"

active_root=$(
	printf '%s\n' "$status" |
		awk -F= '$1 == "ACTIVE_ROOT" { print $2 }'
)

classification=$(
	printf '%s\n' "$status" |
		awk -F= '$1 == "CLASSIFICATION" { print $2 }'
)

[[ $active_root == /dev/mmcblk0p8 ]] ||
	die "active root is not Fre3nder p8"

case "$classification" in
STOCK_A)
	echo 'SELECTOR_ALREADY_SAFE=STOCK_A'
	;;
DEVELOP_B)
	"$ab" "$host" select-a ||
		die "cannot restore STOCK_A selector"
	;;
*)
	die "selector classification is not safely recognized"
	;;
esac


echo
echo '=== FINAL SELECTOR ==='

final_status=$("$ab" "$host" status) ||
	die "cannot verify final X2000 selector state"

printf '%s\n' "$final_status"

final_root=$(
	printf '%s\n' "$final_status" |
		awk -F= '$1 == "ACTIVE_ROOT" { print $2 }'
)

final_classification=$(
	printf '%s\n' "$final_status" |
		awk -F= '$1 == "CLASSIFICATION" { print $2 }'
)

[[ $final_root == /dev/mmcblk0p8 ]] ||
	die "final active root is not Fre3nder p8"

[[ $final_classification == STOCK_A ]] ||
	die "final selector is not STOCK_A"


echo
echo '=== BACKUP RETENTION ==='

mapfile -t completed_backups < <(
	find "$backup_root" \
		-mindepth 1 -maxdepth 1 \
		-type d \
		-name 'home-*' \
		-print |
	sort -r |
	while IFS= read -r candidate; do
		name=${candidate##*/}

		[[ $name =~ ^home-[0-9]{8}T[0-9]{6}$ ]] ||
			continue

		[[ -f $candidate/.fre3nder-backup-complete &&
		   ! -L $candidate/.fre3nder-backup-complete ]] ||
			continue

		printf '%s\n' "$candidate"
	done
)

if (( ${#completed_backups[@]} > 3 )); then
	for ((i = 3; i < ${#completed_backups[@]}; i++)); do
		echo "REMOVE_OLD_BACKUP=${completed_backups[$i]#$root/}"
		rm -rf -- "${completed_backups[$i]}"
	done
fi

echo "COMPLETED_BACKUPS_KEPT=$(
	find "$backup_root" \
		-mindepth 1 -maxdepth 1 \
		-type d \
		-name 'home-*' \
		-exec test -f '{}/.fre3nder-backup-complete' ';' \
		-print |
	wc -l
)"

echo
echo 'DEVELOPMENT_PREPARE=PASS'
