#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
image=ender3-v3-ke-x2000-prototype:phase3.3a
runtime_user=$(id -u):$(id -g)

build_target=build
provision=false
ramboot=false
slot_b_smoke=false
slot_b_network_smoke=false
for option do
	case "$option" in
	--provision)
		[ "$provision" = false ] || { echo 'duplicate --provision' >&2; exit 2; }
		provision=true
		;;
	--ramboot)
		[ "$ramboot" = false ] || { echo 'duplicate --ramboot' >&2; exit 2; }
		ramboot=true
		;;
	--slot-b-smoke)
		[ "$slot_b_smoke" = false ] || { echo 'duplicate --slot-b-smoke' >&2; exit 2; }
		slot_b_smoke=true
		;;
	--slot-b-network-smoke)
		[ "$slot_b_network_smoke" = false ] || { echo 'duplicate --slot-b-network-smoke' >&2; exit 2; }
		slot_b_network_smoke=true
		;;
	*) echo "usage: $0 [--ramboot] [--provision] [--slot-b-smoke] [--slot-b-network-smoke]" >&2; exit 2 ;;
	esac
done

[ "$slot_b_smoke" = false ] || {
	[ "$ramboot" = false ] || { echo '--slot-b-smoke cannot be combined with --ramboot' >&2; exit 2; }
	[ "$provision" = false ] || { echo '--slot-b-smoke cannot be combined with --provision' >&2; exit 2; }
}

[ "$slot_b_network_smoke" = false ] || {
	[ "$ramboot" = false ] || { echo '--slot-b-network-smoke cannot be combined with --ramboot' >&2; exit 2; }
	[ "$slot_b_smoke" = false ] || { echo '--slot-b-network-smoke cannot be combined with --slot-b-smoke' >&2; exit 2; }
	[ "$provision" = false ] || { echo '--slot-b-network-smoke implies provisioning; omit --provision' >&2; exit 2; }
}

require_local_input() {
	path=$1
	label=$2
	[ -r "$path" ] || {
		echo "required local input missing or unreadable: $label" >&2
		exit 1
	}
}

if [ "$provision" = true ]; then
	require_local_input "$root/local/phase3/provision/wpa_supplicant.conf" 'local/phase3/provision/wpa_supplicant.conf'
	require_local_input "$root/local/phase3/provision/authorized_keys" 'local/phase3/provision/authorized_keys'
	if [ "$ramboot" = true ]; then
		build_target=build-ramboot-provisioned
	else
		build_target=build-provisioned
	fi
elif [ "$ramboot" = true ]; then
	build_target=build-ramboot
elif [ "$slot_b_smoke" = true ]; then
	build_target=build-slot-b-smoke
elif [ "$slot_b_network_smoke" = true ]; then
	require_local_input "$root/local/phase3/provision/wpa_supplicant.conf" 'local/phase3/provision/wpa_supplicant.conf'
	require_local_input "$root/local/phase3/provision/authorized_keys" 'local/phase3/provision/authorized_keys'
	require_local_input "$root/local/phase3/wifi/brcmfmac43430-sdio.bin" 'local/phase3/wifi/brcmfmac43430-sdio.bin'
	require_local_input "$root/local/phase3/wifi/brcmfmac43430-sdio.txt" 'local/phase3/wifi/brcmfmac43430-sdio.txt'
	build_target=build-slot-b-network-smoke
fi

git -C "$root" check-ignore -q local/phase3
docker build -t "$image" "$root/build/x2000-prototype"
mkdir -p "$root/local/phase3/x2000-prototype-work"
docker run --rm --user "$runtime_user" -v "$root:/project" -v "$root/local/phase3/x2000-prototype-work:/work" "$image" fetch
docker run --rm --network none --user "$runtime_user" -v "$root:/project" -v "$root/local/phase3/x2000-prototype-work:/work" "$image" "$build_target"
