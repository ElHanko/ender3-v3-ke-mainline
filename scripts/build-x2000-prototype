#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
image=ender3-v3-ke-x2000-prototype:phase3.3a
runtime_user=$(id -u):$(id -g)

build_target=build
provision=false
ramboot=false
for option do
	case "$option" in
	--provision)
		[ "$provision" = false ] || { echo 'duplicate --provision' >&2; exit 2; }
		provision=true
		;;
	--ramboot)
		[ "$ramboot" = false ] || { echo 'duplicate --ramboot' >&2; exit 2; }
		ramboot=true
		;;
	*) echo "usage: $0 [--ramboot] [--provision]" >&2; exit 2 ;;
	esac
done

if [ "$provision" = true ]; then
	[ -r "$root/local/phase3/provision/wpa_supplicant.conf" ]
	[ -r "$root/local/phase3/provision/authorized_keys" ]
	if [ "$ramboot" = true ]; then
		build_target=build-ramboot-provisioned
	else
		build_target=build-provisioned
	fi
elif [ "$ramboot" = true ]; then
	build_target=build-ramboot
fi

git -C "$root" check-ignore -q local/phase3
docker build -t "$image" "$root/build/x2000-prototype"
mkdir -p "$root/local/phase3/x2000-prototype-work"
docker run --rm --user "$runtime_user" -v "$root:/project" -v "$root/local/phase3/x2000-prototype-work:/work" "$image" fetch
docker run --rm --network none --user "$runtime_user" -v "$root:/project" -v "$root/local/phase3/x2000-prototype-work:/work" "$image" "$build_target"
