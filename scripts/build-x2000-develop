#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
image=ender3-v3-ke-x2000-develop:phase3.4-v0
runtime_user=$(id -u):$(id -g)

build_target=build
case "$#" in
0) ;;
1)
	case "$1" in
	--kernel-only) build_target=build-kernel-only ;;
	--rootfs-only) build_target=build-rootfs-only ;;
	*)
		echo "usage: $0 [--kernel-only|--rootfs-only]" >&2
		exit 2
		;;
	esac
	;;
*)
	echo "usage: $0 [--kernel-only|--rootfs-only]" >&2
	exit 2
	;;
esac

firmware="$root/local/phase3/wifi/brcmfmac43430-sdio.bin"
nvram="$root/local/phase3/wifi/brcmfmac43430-sdio.txt"

[ -r "$firmware" ] || {
	echo 'required BYOF input missing: local/phase3/wifi/brcmfmac43430-sdio.bin' >&2
	exit 1
}
[ -r "$nvram" ] || {
	echo 'required BYOF input missing: local/phase3/wifi/brcmfmac43430-sdio.txt' >&2
	exit 1
}
[ "$(sha256sum "$firmware" | awk '{print $1}')" = \
	60dbb5b77b2c232e513322e0ff4350ab5dab5a9fcad0e26e80a2f089e652d720 ] || {
	echo 'BYOF WLAN firmware hash mismatch' >&2
	exit 1
}
[ "$(sha256sum "$nvram" | awk '{print $1}')" = \
	78fee458ab69c0a66ea462f6d6769e15b36f73582693f4dbb5a0e8e8be3cfb0a ] || {
	echo 'BYOF WLAN NVRAM hash mismatch' >&2
	exit 1
}

git -C "$root" check-ignore -q local/phase3
docker build -t "$image" "$root/build/x2000-develop"
mkdir -p "$root/local/phase3/x2000-develop-work"
docker run --rm --user "$runtime_user" \
	-v "$root:/project" \
	-v "$root/local/phase3/x2000-develop-work:/work" \
	"$image" fetch
docker run --rm --network none --user "$runtime_user" \
	-v "$root:/project" \
	-v "$root/local/phase3/x2000-develop-work:/work" \
	"$image" "$build_target"
