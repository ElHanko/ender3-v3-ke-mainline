#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
deploy="$root/scripts/deploy-x2000-rootfs"
tmp=$(mktemp -d)

cleanup() {
	status=$?
	rm -rf -- "$tmp"
	exit "$status"
}
trap cleanup EXIT HUP INT TERM

artifact_dir=$tmp/artifact
bin=$tmp/bin
state=$tmp/state
selector=$tmp/selector
log=$tmp/log
p8=$tmp/p8
operator_input=$tmp/operator-input
mkdir -p "$bin"

cat > "$bin/ab" <<'EOF'
#!/bin/sh
set -eu

host=$1
action=$2
phase=$(cat "$X2000_TEST_STATE")

root_for_phase() {
	case "$1" in
	develop-initial) printf '%s\n' "${X2000_TEST_DEVELOP_ROOT:-/dev/mmcblk0p8}" ;;
	develop-initial-after-a) printf '%s\n' "${X2000_TEST_INITIAL_AFTER_A_ROOT:-/dev/mmcblk0p8}" ;;
	develop-after-b) printf '%s\n' "${X2000_TEST_POST_B_ROOT:-/dev/mmcblk0p8}" ;;
	develop-final) printf '%s\n' "${X2000_TEST_FINAL_ROOT:-/dev/mmcblk0p8}" ;;
	stock) printf '%s\n' "${X2000_TEST_STOCK_ROOT:-/dev/mmcblk0p7}" ;;
	esac
}

selector_for_phase() {
	current=$(cat "$X2000_TEST_SELECTOR")
	case "$1" in
	develop-initial) printf '%s\n' "${X2000_TEST_DEVELOP_SELECTOR:-$current}" ;;
	develop-initial-after-a) printf '%s\n' "${X2000_TEST_INITIAL_AFTER_A_SELECTOR:-$current}" ;;
	develop-after-b) printf '%s\n' "${X2000_TEST_POST_B_SELECTOR:-$current}" ;;
	develop-final) printf '%s\n' "${X2000_TEST_FINAL_SELECTOR:-$current}" ;;
	stock) printf '%s\n' "${X2000_TEST_STOCK_SELECTOR:-$current}" ;;
	esac
}

case "$action" in
status)
	case "$host:$phase" in
	develop:develop-initial|develop:develop-initial-after-a|develop:develop-after-b|develop:develop-final|stock:stock) ;;
	*) exit 1 ;;
	esac
	case "$phase" in
	stock) [ "${X2000_TEST_STOCK_AVAILABLE:-true}" = true ] ;;
	develop-after-b) [ "${X2000_TEST_POST_B_AVAILABLE:-true}" = true ] ;;
	esac
	active_root=$(root_for_phase "$phase")
	selector=$(selector_for_phase "$phase")
	printf '%s\n' \
		"ACTIVE_ROOT=$active_root" \
		'P1_DEVICE=/dev/mmcblk0p1' \
		'P1_PARTITION_NUMBER=1' \
		'P1_START=2048' \
		'P1_SECTORS=2048' \
		'P1_IDENTITY=VALID' \
		"CLASSIFICATION=$selector"
	;;
select-b)
	[ "$host" = stock ] && [ "$phase" = stock ] || exit 1
	[ "$(cat "$X2000_TEST_SELECTOR")" = STOCK_A ] || exit 1
	printf 'select-b\n' >> "$X2000_TEST_LOG"
	[ "${X2000_TEST_SELECT_FAIL:-false}" != true ] || exit 1
	printf DEVELOP_B > "$X2000_TEST_SELECTOR"
	;;
select-a)
	[ "$host" = develop ] || exit 1
	case "$phase" in
	develop-initial|develop-after-b) ;;
	*) exit 1 ;;
	esac
	[ "$(cat "$X2000_TEST_SELECTOR")" = DEVELOP_B ] || exit 1
	printf 'select-a\n' >> "$X2000_TEST_LOG"
	if [ "$phase" = develop-initial ]; then
		[ "${X2000_TEST_INITIAL_SELECT_A_FAIL:-false}" != true ] || exit 1
	else
		[ "${X2000_TEST_SELECT_A_FAIL:-false}" != true ] || exit 1
	fi
	printf STOCK_A > "$X2000_TEST_SELECTOR"
	if [ "$phase" = develop-initial ]; then
		printf develop-initial-after-a > "$X2000_TEST_STATE"
	else
		printf develop-final > "$X2000_TEST_STATE"
	fi
	;;
*) exit 1 ;;
esac
EOF

cat > "$bin/ssh" <<'EOF'
#!/bin/sh
set -eu

while [ "$#" -gt 0 ]; do
	case "$1" in
	-o) shift 2 ;;
	*) host=$1; shift; break ;;
	esac
done
command=${1:-}
phase=$(cat "$X2000_TEST_STATE")

root_for_phase() {
	case "$1" in
	develop-initial) printf '%s\n' "${X2000_TEST_DEVELOP_ROOT:-/dev/mmcblk0p8}" ;;
	develop-initial-after-a) printf '%s\n' "${X2000_TEST_INITIAL_AFTER_A_ROOT:-/dev/mmcblk0p8}" ;;
	develop-after-b) printf '%s\n' "${X2000_TEST_POST_B_ROOT:-/dev/mmcblk0p8}" ;;
	develop-final) printf '%s\n' "${X2000_TEST_FINAL_ROOT:-/dev/mmcblk0p8}" ;;
	stock) printf '%s\n' "${X2000_TEST_STOCK_ROOT:-/dev/mmcblk0p7}" ;;
	esac
}

partlabel_for_phase() {
	case "$1" in
	stock) printf '%s\n' "${X2000_TEST_STOCK_P8_PARTLABEL:-VALID}" ;;
	*) printf '%s\n' "${X2000_TEST_DEVELOP_P8_PARTLABEL:-VALID}" ;;
	esac
}

case "$command" in
'sync; reboot')
	printf 'reboot %s\n' "$host" >> "$X2000_TEST_LOG"
	case "$host:$phase" in
	develop:develop-initial|develop:develop-initial-after-a)
		[ "${X2000_TEST_REBOOT_DEVELOP:-true}" = true ] && printf stock > "$X2000_TEST_STATE"
		;;
	stock:stock)
		[ "${X2000_TEST_REBOOT_STOCK:-true}" = true ] && printf develop-after-b > "$X2000_TEST_STATE"
		;;
	*) exit 1 ;;
	esac
	;;
'sh -eu')
	cat >/dev/null
	case "$host:$phase" in
	develop:develop-initial|develop:develop-initial-after-a|develop:develop-after-b|develop:develop-final|stock:stock) ;;
	*) exit 1 ;;
	esac
	active_root=$(root_for_phase "$phase")
	p8_partlabel=$(partlabel_for_phase "$phase")
	[ "$p8_partlabel" != WRONG_ROOTFS2 ] || exit 1
	p8_mounted=YES
	[ "$phase" = stock ] && p8_mounted=${X2000_TEST_STOCK_P8_MOUNTED:-NO}
	printf '%s\n' \
		"ACTIVE_ROOT=$active_root" \
		'P8_DEVICE=/dev/mmcblk0p8' \
		"P8_PARTLABEL=$p8_partlabel" \
		'P8_PARTITION_NUMBER=8' \
		"P8_SECTORS=${X2000_TEST_STOCK_P8_SECTORS:-1024000}" \
		"P8_MOUNTED=$p8_mounted"
	;;
'dd of=/dev/mmcblk0p8 bs=4096 2>/dev/null && sync')
	[ "$host:$phase" = stock:stock ] || exit 1
	printf 'write\n' >> "$X2000_TEST_LOG"
	[ "${X2000_TEST_WRITE_FAIL:-false}" != true ] || exit 1
	cat > "$X2000_TEST_P8"
	;;
dd\ if=/dev/mmcblk0p8\ bs=512\ count=*)
	[ "$host:$phase" = stock:stock ] || exit 1
	printf 'readback\n' >> "$X2000_TEST_LOG"
	if [ "${X2000_TEST_READBACK_BAD:-false}" = true ]; then
		printf corrupt
	else
		cat "$X2000_TEST_P8"
	fi
	;;
*) exit 1 ;;
esac
EOF

chmod 0755 "$bin/ab" "$bin/ssh"

reset_case() {
	rm -rf -- "$artifact_dir" "$state" "$selector" "$log" "$p8" "$operator_input"
	mkdir -p "$artifact_dir"
	printf rootfs > "$artifact_dir/rootfs.squashfs"
	printf config > "$artifact_dir/buildroot.config"
	(
		cd "$artifact_dir"
		sha256sum rootfs.squashfs buildroot.config > SHA256SUMS
	)
	printf develop-initial > "$state"
	printf STOCK_A > "$selector"
	unset X2000_TEST_DEVELOP_ROOT X2000_TEST_INITIAL_AFTER_A_ROOT X2000_TEST_POST_B_ROOT X2000_TEST_FINAL_ROOT
	unset X2000_TEST_DEVELOP_SELECTOR X2000_TEST_INITIAL_AFTER_A_SELECTOR
	unset X2000_TEST_POST_B_SELECTOR X2000_TEST_FINAL_SELECTOR
	unset X2000_TEST_STOCK_ROOT X2000_TEST_STOCK_SELECTOR X2000_TEST_STOCK_P8_MOUNTED
	unset X2000_TEST_DEVELOP_P8_PARTLABEL X2000_TEST_STOCK_P8_PARTLABEL X2000_TEST_STOCK_P8_SECTORS
	unset X2000_TEST_REBOOT_DEVELOP X2000_TEST_REBOOT_STOCK
	unset X2000_TEST_STOCK_AVAILABLE X2000_TEST_POST_B_AVAILABLE
	unset X2000_TEST_WRITE_FAIL X2000_TEST_READBACK_BAD X2000_TEST_SELECT_FAIL
	unset X2000_TEST_INITIAL_SELECT_A_FAIL X2000_TEST_SELECT_A_FAIL
}

reset_stock_case() {
	reset_case
	printf stock > "$state"
}

run_deploy_with_input() {
	input=$1
	shift
	X2000_DEPLOY_ARTIFACT_DIR="$artifact_dir" \
	X2000_DEPLOY_SSH="$bin/ssh" \
	X2000_DEPLOY_AB="$bin/ab" \
	X2000_TEST_STATE="$state" \
	X2000_TEST_SELECTOR="$selector" \
	X2000_TEST_LOG="$log" \
	X2000_TEST_P8="$p8" \
	"$deploy" develop stock "$@" < "$input"
}

run_deploy() {
	if [ "${1:-}" = --write ]; then
		printf '\n\n' > "$operator_input"
	else
		: > "$operator_input"
	fi
	run_deploy_with_input "$operator_input" "$@"
}

run_deploy_without_confirmation() {
	: > "$operator_input"
	run_deploy_with_input "$operator_input" "$@"
}

run_deploy_with_one_confirmation() {
	printf '\n' > "$operator_input"
	run_deploy_with_input "$operator_input" "$@"
}

must_fail() {
	if "$@" >/dev/null 2>&1; then
		echo "unexpected success: $*" >&2
		exit 1
	fi
}

assert_not_called() {
	! grep -Fq "$1" "$log" 2>/dev/null
}

# A present, correct rootfs2 mapping is accepted and default mode remains
# strictly printer-side read-only.
reset_case
X2000_TEST_DEVELOP_P8_PARTLABEL=VALID run_deploy > "$tmp/default.out"
grep -Fq 'no printer-side writes, selector changes, or reboots' "$tmp/default.out"
assert_not_called reboot
assert_not_called write
assert_not_called select-b
assert_not_called select-a

# Develop without partlabel infrastructure is also accepted.
reset_case
X2000_TEST_DEVELOP_P8_PARTLABEL=ABSENT_INFRASTRUCTURE run_deploy > "$tmp/default-no-partlabel.out"
grep -Fq 'no printer-side writes, selector changes, or reboots' "$tmp/default-no-partlabel.out"
assert_not_called reboot
assert_not_called write
assert_not_called select-a

# A present but incorrect rootfs2 mapping remains fail-closed.
reset_case
X2000_TEST_DEVELOP_P8_PARTLABEL=WRONG_ROOTFS2 must_fail run_deploy
assert_not_called reboot
assert_not_called write
assert_not_called select-a

reset_case
printf DEVELOP_B > "$selector"
run_deploy > "$tmp/default-b.out"
grep -Fq 'no printer-side writes, selector changes, or reboots' "$tmp/default-b.out"
assert_not_called reboot
assert_not_called write
assert_not_called select-b
assert_not_called select-a

# Local artifact validation fails before any host operation.
reset_case
rm "$artifact_dir/buildroot.config"
must_fail run_deploy
assert_not_called reboot
assert_not_called write

# Develop-side preflight rejects an unexpected root or selector.
reset_case
X2000_TEST_DEVELOP_ROOT=/dev/mmcblk0p7 must_fail run_deploy
assert_not_called reboot

reset_case
printf UNKNOWN > "$selector"
must_fail run_deploy
assert_not_called reboot
assert_not_called write
assert_not_called select-a

# Initial Develop-B is normalized through x2000-ab before any reboot or p8
# write; either selector failure or failed verification stops immediately.
reset_case
printf DEVELOP_B > "$selector"
X2000_TEST_INITIAL_SELECT_A_FAIL=true must_fail run_deploy --write
grep -Fxq select-a "$log"
assert_not_called reboot
assert_not_called write

reset_case
printf DEVELOP_B > "$selector"
X2000_TEST_INITIAL_AFTER_A_SELECTOR=DEVELOP_B must_fail run_deploy --write
grep -Fxq select-a "$log"
assert_not_called reboot
assert_not_called write

# The first reboot stops at the Stock operator gate. With exactly one ENTER,
# execution reaches and stops at the Develop operator gate after the second
# reboot.
reset_case
if run_deploy_without_confirmation --write > "$tmp/no-confirmation.out" 2>&1; then
	echo "unexpected success without operator confirmation" >&2
	exit 1
fi
grep -Fq 'Stock A wurde zum Booten aufgefordert.' "$tmp/no-confirmation.out"
printf '%s\n' 'reboot develop' > "$tmp/expected-no-confirmation.log"
cmp -s "$tmp/expected-no-confirmation.log" "$log"

reset_case
if run_deploy_with_one_confirmation --write > "$tmp/one-confirmation.out" 2>&1; then
	echo "unexpected success with only one operator confirmation" >&2
	exit 1
fi
grep -Fq 'Stock A wurde zum Booten aufgefordert.' "$tmp/one-confirmation.out"
grep -Fq 'Fre3nder B wurde zum Booten aufgefordert.' "$tmp/one-confirmation.out"
printf '%s\n' \
	'reboot develop' \
	write \
	readback \
	select-b \
	'reboot stock' > "$tmp/expected-one-confirmation.log"
cmp -s "$tmp/expected-one-confirmation.log" "$log"

# A failed SSH/state check after either confirmation remains fail-closed.
reset_case
X2000_TEST_STOCK_AVAILABLE=false must_fail run_deploy --write
grep -Fxq 'reboot develop' "$log"
assert_not_called write

reset_case
X2000_TEST_POST_B_AVAILABLE=false must_fail run_deploy --write
grep -Fxq 'reboot stock' "$log"
assert_not_called select-a

# No Stock-A return, wrong Stock root, or mounted p8 all stop before writing.
reset_case
X2000_TEST_REBOOT_DEVELOP=false must_fail run_deploy --write
assert_not_called write
assert_not_called select-b

reset_case
X2000_TEST_STOCK_ROOT=/dev/mmcblk0p8 must_fail run_deploy --write
assert_not_called write
assert_not_called select-b

reset_case
X2000_TEST_STOCK_P8_MOUNTED=YES must_fail run_deploy --write
assert_not_called write
assert_not_called select-b

reset_case
X2000_TEST_STOCK_P8_SECTORS=1023999 must_fail run_deploy --write
assert_not_called write
assert_not_called select-b

# Write and readback failures never select B.
reset_case
X2000_TEST_WRITE_FAIL=true must_fail run_deploy --write
grep -Fq write "$log"
assert_not_called select-b
assert_not_called 'reboot stock'

reset_case
X2000_TEST_READBACK_BAD=true must_fail run_deploy --write
grep -Fq readback "$log"
assert_not_called select-b
assert_not_called 'reboot stock'

# A selector failure prevents the second reboot.
reset_case
X2000_TEST_SELECT_FAIL=true must_fail run_deploy --write
grep -Fq select-b "$log"
assert_not_called 'reboot stock'
assert_not_called select-a

# A missing Develop return or invalid post-reboot B state stops before select-a.
reset_case
X2000_TEST_REBOOT_STOCK=false must_fail run_deploy --write
grep -Fq select-b "$log"
grep -Fq 'reboot stock' "$log"
assert_not_called select-a

reset_case
X2000_TEST_POST_B_ROOT=/dev/mmcblk0p7 must_fail run_deploy --write
grep -Fq select-b "$log"
assert_not_called select-a

reset_case
X2000_TEST_POST_B_SELECTOR=STOCK_A must_fail run_deploy --write
grep -Fq select-b "$log"
assert_not_called select-a

# select-a failure and either invalid final invariant fail after the verified
# Develop-B state without attempting any reboot or further selector change.
reset_case
X2000_TEST_SELECT_A_FAIL=true must_fail run_deploy --write
grep -Fq select-a "$log"
[ "$(cat "$selector")" = DEVELOP_B ]

reset_case
X2000_TEST_FINAL_ROOT=/dev/mmcblk0p7 must_fail run_deploy --write
grep -Fq select-a "$log"

reset_case
X2000_TEST_FINAL_SELECTOR=DEVELOP_B must_fail run_deploy --write
grep -Fq select-a "$log"

# Initial Stock-A follows the complete B -> A -> B path without an initial
# select-a and returns with an explicitly restored Stock-A selector.
reset_case
run_deploy --write > "$tmp/success.out"
grep -Fq 'rootfs artifact readback: PASS' "$tmp/success.out"
grep -Fq 'final active root: /dev/mmcblk0p8' "$tmp/success.out"
grep -Fq 'final selector: STOCK_A' "$tmp/success.out"
grep -Fq 'B->A->B deployment: PASS' "$tmp/success.out"
grep -Fxq 'reboot develop' "$log"
grep -Fxq write "$log"
grep -Fxq readback "$log"
grep -Fxq select-b "$log"
grep -Fxq 'reboot stock' "$log"
grep -Fxq select-a "$log"
[ "$(cat "$selector")" = STOCK_A ]
printf '%s\n' \
	'reboot develop' \
	write \
	readback \
	select-b \
	'reboot stock' \
	select-a > "$tmp/expected.log"
cmp -s "$tmp/expected.log" "$log"

# Initial Develop-B is first normalized to Stock-A, then follows the identical
# deployment path and restores Stock-A after the second Develop boot.
reset_case
printf DEVELOP_B > "$selector"
run_deploy --write > "$tmp/success-b.out"
grep -Fq 'rootfs artifact readback: PASS' "$tmp/success-b.out"
grep -Fq 'final active root: /dev/mmcblk0p8' "$tmp/success-b.out"
grep -Fq 'final selector: STOCK_A' "$tmp/success-b.out"
grep -Fq 'B->A->B deployment: PASS' "$tmp/success-b.out"
[ "$(cat "$selector")" = STOCK_A ]
printf '%s\n' \
	select-a \
	'reboot develop' \
	write \
	readback \
	select-b \
	'reboot stock' \
	select-a > "$tmp/expected-b.log"
cmp -s "$tmp/expected-b.log" "$log"

# A validated direct Stock-A start resumes without an initial selector write,
# reboot, or operator gate. Its first persistent action is the p8 write.
reset_stock_case
run_deploy --write > "$tmp/success-direct-stock.out"
grep -Fq 'B->A->B deployment: PASS' "$tmp/success-direct-stock.out"
! grep -Fq 'Stock A wurde zum Booten aufgefordert.' "$tmp/success-direct-stock.out"
[ "$(cat "$selector")" = STOCK_A ]
printf '%s\n' \
	write \
	readback \
	select-b \
	'reboot stock' \
	select-a > "$tmp/expected-direct-stock.log"
cmp -s "$tmp/expected-direct-stock.log" "$log"

# Direct Stock starts with any selector other than Stock-A, or with an
# inconsistent root, are refused before the p8 write.
reset_stock_case
printf DEVELOP_B > "$selector"
must_fail run_deploy --write
assert_not_called write
assert_not_called reboot
assert_not_called select-a

reset_stock_case
printf UNKNOWN > "$selector"
must_fail run_deploy --write
assert_not_called write
assert_not_called reboot
assert_not_called select-a

reset_stock_case
X2000_TEST_STOCK_ROOT=/dev/mmcblk0p8 must_fail run_deploy --write
assert_not_called write
assert_not_called reboot
assert_not_called select-a

# Stock without partlabel infrastructure is accepted when the fixed p8 and
# sysfs identity checks still pass.
reset_case
X2000_TEST_STOCK_P8_PARTLABEL=ABSENT_INFRASTRUCTURE run_deploy --write > "$tmp/success-stock-no-partlabel.out"
grep -Fq 'B->A->B deployment: PASS' "$tmp/success-stock-no-partlabel.out"
[ "$(cat "$selector")" = STOCK_A ]

echo 'fre3nder-x2000 RootFS deployment fixture tests: PASS'
