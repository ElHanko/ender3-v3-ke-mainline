#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
version_file="$root/VERSION"
[ -f "$version_file" ] || {
	echo 'VERSION is missing' >&2
	exit 1
}
version=$(cat "$version_file")
if [ "$(wc -l < "$version_file")" -ne 1 ] ||
	! printf '%s\n' "$version" | cmp -s - "$version_file" ||
	! printf '%s\n' "$version" |
		grep -Eq '^[1-9][0-9]{3}\.[1-9][0-9]*(\.(a|b|rc))?$'; then
	echo 'VERSION must use YEAR.RELEASE[.a|.b|.rc] with a final newline' >&2
	exit 1
fi
image="ender3-v3-ke-fre3nder-x2000:$version"
runtime_user=$(id -u):$(id -g)

build_target=build
case "$#" in
0) ;;
1)
	case "$1" in
	--kernel-only) build_target=build-kernel-only ;;
	--rootfs-only) build_target=build-rootfs-only ;;
	*)
		echo "usage: $0 [--kernel-only|--rootfs-only]" >&2
		exit 2
		;;
	esac
	;;
*)
	echo "usage: $0 [--kernel-only|--rootfs-only]" >&2
	exit 2
	;;
esac

local_root="$root/local/production"
input_root="$local_root/inputs"
work_root="$local_root/work/x2000"
firmware="$input_root/wifi/brcmfmac43430-sdio.bin"
nvram="$input_root/wifi/brcmfmac43430-sdio.txt"

[ -r "$firmware" ] || {
	echo 'required BYOF input missing: local/production/inputs/wifi/brcmfmac43430-sdio.bin' >&2
	exit 1
}
[ -r "$nvram" ] || {
	echo 'required BYOF input missing: local/production/inputs/wifi/brcmfmac43430-sdio.txt' >&2
	exit 1
}
[ "$(sha256sum "$firmware" | awk '{print $1}')" = \
	60dbb5b77b2c232e513322e0ff4350ab5dab5a9fcad0e26e80a2f089e652d720 ] || {
	echo 'BYOF WLAN firmware hash mismatch' >&2
	exit 1
}
[ "$(sha256sum "$nvram" | awk '{print $1}')" = \
	78fee458ab69c0a66ea462f6d6769e15b36f73582693f4dbb5a0e8e8be3cfb0a ] || {
	echo 'BYOF WLAN NVRAM hash mismatch' >&2
	exit 1
}

git -C "$root" check-ignore -q local/production
docker build -t "$image" "$root/build/x2000"
mkdir -p "$work_root"
docker run --rm --user "$runtime_user" \
	-v "$root:/project" \
	-v "$work_root:/work" \
	"$image" fetch
docker run --rm --network none --user "$runtime_user" \
	-v "$root:/project" \
	-v "$work_root:/work" \
	"$image" "$build_target"
