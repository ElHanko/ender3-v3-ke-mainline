#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
entrypoint="$root/build/x2000/entrypoint.sh"
base="$root/configs/x2000/buildroot.defconfig"
fragment="$root/configs/x2000/buildroot.fragment"
sources="$root/configs/x2000/sources.json"
moonraker_wheels="$root/configs/x2000/moonraker-python-wheels.json"
streaming_package="$root/configs/x2000/buildroot-external/package/python-streaming-form-data"

python3 - "$sources" <<'PY'
import json
import pathlib
import sys

data = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
buildroot = data["buildroot"]
assert buildroot == {
    "version": "2025.02.17",
    "url": "https://gitlab.com/buildroot.org/buildroot.git",
    "commit": "d0820dd09916edcefc44e525355afbea30d5bee4",
    "source": "upstream Buildroot",
}
greenlet = data["userspace"]["greenlet"]
assert greenlet == {
    "version": "3.1.1",
    "license": "MIT, PSF-2.0",
    "source": "upstream Buildroot 2025.02.17 package",
    "required_by": (
        "Klipper 0499b30374315f2a9f49fc12808527fc7d0f5cfa for Python >= 3.12"),
}
assert data["userspace_toolchain"] == {
    "identity": "Buildroot internal toolchain",
    "source": "upstream Buildroot 2025.02.17",
    "binutils": "2.43.1",
    "gcc": "13.4.0",
    "libc": "glibc",
    "kernel_headers": "6.6",
    "target": "mipsel MIPS32r2 O32 hard-float FPXX NaN2008",
    "hardware_validated": True,
}
assert data["kernel_toolchain"] == {
    "identity": "Buildroot internal toolchain",
    "source": "upstream Buildroot 2025.02.17",
    "binutils": "2.43.1",
    "gcc": "13.4.0",
    "compiler": "mipsel-buildroot-linux-gnu-gcc.br_real",
    "target": "mipsel MIPS32r5 O32 soft-float legacy-NaN",
    "relationship": (
        "same toolchain family as userspace, with separate Kbuild target flags"),
    "hardware_validated": True,
}
assert data["userspace"]["moonraker"] == {
    "repository": "https://github.com/Arksine/moonraker.git",
    "commit": "985c1d0bbeb90bc057d34a232c9dc3b05e0c6c8d",
    "license": "GPL-3.0-only",
    "role": "qualified RootFS application baseline",
}
PY

python3 - "$moonraker_wheels" <<'PY'
import json
import pathlib
import re
import sys

data = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
assert data["schema"] == 1
assert data["target"] == {
    "python": "3.12",
    "platform": "any",
    "implementation": "py",
    "abi": "none",
}
assert {wheel["name"] for wheel in data["wheels"]} == {
    "apprise",
    "importlib-metadata",
    "inotify-simple",
    "ldap3",
    "libnacl",
    "preprocess-cancellation",
    "pyserial",
    "smart-open",
    "zipp",
}
assert all(re.fullmatch(r"[0-9a-f]{64}", wheel["sha256"])
           for wheel in data["wheels"])
PY

# The staged layout is a PEP 405 environment, not merely a directory named
# "venv". Verify the same pyvenv.cfg and executable-link mechanism with the
# host CPython; target execution remains a build/hardware qualification item.
python3 - <<'PY'
import pathlib
import subprocess
import sys
import tempfile

with tempfile.TemporaryDirectory() as tmp:
    env = pathlib.Path(tmp) / "moonraker-env"
    (env / "bin").mkdir(parents=True)
    (env / "bin/python").symlink_to(sys.executable)
    (env / "pyvenv.cfg").write_text(
        f"home = {pathlib.Path(sys.executable).parent}\n"
        "include-system-site-packages = true\n"
        f"version = {sys.version_info.major}.{sys.version_info.minor}.{sys.version_info.micro}\n",
        encoding="utf-8",
    )
    subprocess.run(
        [
            str(env / "bin/python"),
            "-c",
            "import pathlib,sys; assert pathlib.Path(sys.prefix)==pathlib.Path(sys.argv[1]); assert sys.base_prefix != sys.prefix",
            str(env),
        ],
        check=True,
    )
PY

grep -Fxq 'buildroot="$work/buildroot"' "$entrypoint"
grep -Fxq 'buildroot_dl="$work/buildroot-dl"' "$entrypoint"
grep -Fxq 'buildroot_version=2025.02.17' "$entrypoint"
grep -Fxq 'buildroot_commit=d0820dd09916edcefc44e525355afbea30d5bee4' \
	"$entrypoint"
grep -Fq 'config BR2_mips_xburst2' "$entrypoint"
grep -Fq 'BR_FP_CONTRACT_OFF' "$entrypoint"
grep -Fq -- '-ffp-contract=off' "$entrypoint"
grep -Fq 'PYTHON_GREENLET_VERSION = 3.1.1' "$entrypoint"
grep -Fq 'BR2_DL_DIR="$buildroot_dl"' "$entrypoint"
grep -Fq 'BR2_GLOBAL_PATCH_DIR="$project/patches"' "$entrypoint"
grep -Fq 'BR2_EXTERNAL="$buildroot_external"' "$entrypoint"
grep -Fxq 'name: FRE3NDER' "$root/configs/x2000/buildroot-external/external.desc"
grep -Fq 'python-streaming-form-data' \
	"$root/configs/x2000/buildroot-external/Config.in"
grep -Fxq 'PYTHON_STREAMING_FORM_DATA_VERSION = 2.1.0' \
	"$streaming_package/python-streaming-form-data.mk"
grep -Fq '2c5c81fc9c451ea133083bc6da959f87e9b91fba3effe99411f1f90461ea7c5b' \
	"$streaming_package/python-streaming-form-data.hash"
grep -Fq 'BR2_GCC_TARGET_ARCH="mips32r2"' "$entrypoint"
grep -Fq 'BR2_GCC_TARGET_ABI="32"' "$entrypoint"
grep -Fq 'BR2_GCC_TARGET_FP32_MODE="xx"' "$entrypoint"
grep -Fq 'BR2_GCC_TARGET_NAN="2008"' "$entrypoint"
grep -Fq 'BR2_BINUTILS_VERSION="2.43.1"' "$entrypoint"
grep -Fq 'BR2_GCC_VERSION="13.4.0"' "$entrypoint"
grep -Fq "! grep -Eq '^BR2_TOOLCHAIN_EXTERNAL(=|_)'" "$entrypoint"
grep -Fq 'FP ABI: Hard float (32-bit CPU, Any FPU)' "$entrypoint"
grep -Fq 'Shared library: [ld-linux-mipsn8.so.1]' "$entrypoint"
! grep -Fq '$sdk/buildroot' "$entrypoint"
! grep -Fq 'halley5_linux_minimal_defconfig' "$entrypoint"
! grep -Fq 'libffi-disable-host-static-exec-tramp' "$entrypoint"
grep -Fxq 'BR2_PACKAGE_GIT=y' "$fragment"
grep -Fxq 'BR2_PACKAGE_LIBCURL=y' "$fragment"
grep -Fxq 'BR2_PACKAGE_LIBCURL_FORCE_TLS=y' "$fragment"
grep -Fxq 'BR2_PACKAGE_LIBCURL_OPENSSL=y' "$fragment"

# These packages remain intentionally disabled in the product configuration,
# but Buildroot may omit invisible Kconfig symbols from the effective .config.
grep -Fxq '# BR2_PACKAGE_I2C_TOOLS is not set' "$fragment"
grep -Fxq '# BR2_PACKAGE_BASH is not set' "$fragment"

# Validate the semantic checks used for the effective RootFS instead of relying
# on invisible Kconfig symbols being materialized as "# ... is not set".
grep -Fq "grep -Fxq '# BR2_PACKAGE_BUSYBOX_SHOW_OTHERS is not set'" "$entrypoint"
grep -Fq -- "-name 'i2c-tools-*' -print -quit" "$entrypoint"
grep -Fq "grep -Fxq 'CONFIG_I2CGET=y'" "$entrypoint"
grep -Fq "grep -Fxq 'CONFIG_I2CSET=y'" "$entrypoint"
grep -Fq "grep -Fxq 'CONFIG_I2CDUMP=y'" "$entrypoint"
grep -Fq "grep -Fxq 'CONFIG_I2CDETECT=y'" "$entrypoint"
grep -Fq "grep -Fxq 'CONFIG_I2CTRANSFER=y'" "$entrypoint"

grep -Fq -- "-name 'bash-*' -print -quit" "$entrypoint"
grep -Fq '[ ! -e "$target/bin/bash" ]' "$entrypoint"
grep -Fq '[ "$(readlink "$target/bin/sh")" = busybox ]' "$entrypoint"
grep -Fq "grep -Fxq 'CONFIG_ASH=y'" "$entrypoint"

! grep -Fq \
	"grep -Fxq '# BR2_PACKAGE_I2C_TOOLS is not set' \"\$brout/.config\"" \
	"$entrypoint"
! grep -Fq \
	"grep -Fxq '# BR2_PACKAGE_BASH is not set' \"\$brout/.config\"" \
	"$entrypoint"

for setting in \
	'BR2_mipsel=y' \
	'BR2_mips_xburst2=y' \
	'# BR2_MIPS_SOFT_FLOAT is not set' \
	'BR2_MIPS_FP32_MODE_XX=y' \
	'BR2_TOOLCHAIN_BUILDROOT=y' \
	'BR2_TOOLCHAIN_BUILDROOT_GLIBC=y' \
	'BR2_KERNEL_HEADERS_6_6=y' \
	'BR2_TOOLCHAIN_BUILDROOT_CXX=y' \
	'BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y'; do
	grep -Fxq "$setting" "$base"
done

! grep -Fq 'BR2_TOOLCHAIN_EXTERNAL' "$base"
! grep -Fq 'BR2_MIPS_NAN_LEGACY=y' "$base"
grep -Fq 'host/bin/mipsel-buildroot-linux-gnu-gcc' "$entrypoint"
grep -Fq 'gcc.br_real' "$entrypoint"
grep -Fq 'git -C "$sdk" sparse-checkout set kernel/kernel-6.6' "$entrypoint"
! grep -Fq 'mips-gcc720-glibc238' "$entrypoint"
! grep -Fq 'CROSS_COMPILE=mips-linux-gnu-' "$entrypoint"
[ "$(grep -Fc 'make -C "$buildroot" O="$brout" -j"$jobs" toolchain' \
	"$entrypoint")" -eq 2 ]

first_toolchain=$(grep -nF 'make -C "$buildroot" O="$brout" -j"$jobs" toolchain' \
	"$entrypoint" | head -n 1 | cut -d: -f1)
first_kernel=$(grep -nF 'prepare_kernel "$kernel_cross_compile" "$kernel_cc"' \
	"$entrypoint" | head -n 1 | cut -d: -f1)
[ "$first_toolchain" -lt "$first_kernel" ]

test -f "$root/patches/buildroot/0001-mips-add-ingenic-xburst2-target.patch"
grep -Fq 'select BR2_MIPS_NAN_2008' \
	"$root/patches/buildroot/0001-mips-add-ingenic-xburst2-target.patch"
grep -Fq '$(BR2_mips_xburst2)' \
	"$root/patches/buildroot/0001-mips-add-ingenic-xburst2-target.patch"
! test -e "$root/patches/python-greenlet/0001-gcc7-avoid-nontrivial-designated-initializers.patch"

echo 'fre3nder-x2000 Buildroot architecture tests: PASS'
