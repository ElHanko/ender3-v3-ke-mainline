#!/bin/sh

state=${FRE3NDER_STATE:-/run/fre3nder}
provisioning=$state/provisioning
fre3nder_root_state=${FRE3NDER_ROOT_STATE:-/run/fre3nder-root}
fre3nder_home=${FRE3NDER_HOME_DIR:-/home/fre3nder}
fre3nder_state_dir=${FRE3NDER_STATE_DIR:-$fre3nder_home/.fre3nder}
fre3nder_ssh_dir=${FRE3NDER_SSH_DIR:-$fre3nder_state_dir/ssh}
runtime=$state/dropbear
root_ssh=$runtime/root-ssh
hostkey=$runtime/dropbear_ed25519_host_key
hostkey_type=${FRE3NDER_DROPBEAR_HOSTKEY_TYPE:-ed25519}
pid_file=$runtime/dropbear.pid
status=$runtime/status
proc_mounts=${FRE3NDER_PROC_MOUNTS:-/proc/mounts}
dropbearkey=${FRE3NDER_DROPBEARKEY:-/usr/bin/dropbearkey}
mount_cmd=${FRE3NDER_MOUNT:-mount}
umount_cmd=${FRE3NDER_UMOUNT:-umount}
dropbear=${FRE3NDER_DROPBEAR:-/usr/sbin/dropbear}

log() {
	echo "fre3nder-x2000 ssh: $*"
}

set_status() {
	mkdir -p "$runtime" 2>/dev/null || return 0
	chmod 0700 "$runtime" 2>/dev/null || true
	printf '%s\n' "$1" > "$status" 2>/dev/null || true
}

enabled() {
	[ -f "$provisioning/authorized_keys" ] &&
		[ ! -L "$provisioning/authorized_keys" ] &&
		[ -s "$provisioning/authorized_keys" ] &&
		[ -f "$provisioning/enable_ssh" ] &&
		[ ! -L "$provisioning/enable_ssh" ] &&
		[ ! -s "$provisioning/enable_ssh" ]
}

root_active() {
	[ -f "$fre3nder_root_state/status" ] &&
		[ ! -L "$fre3nder_root_state/status" ] &&
		[ "$(cat "$fre3nder_root_state/status")" = active ]
}

ensure_private_directory() {
	if [ ! -e "$1" ] && [ ! -L "$1" ]; then
		mkdir -m 0700 "$1" || return 1
	fi
	[ -d "$1" ] && [ ! -L "$1" ] || return 1
	chmod 0700 "$1"
}

prepare_persistent_directory() {
	root_active || return 1
	ensure_private_directory "$fre3nder_home" || return 1
	ensure_private_directory "$fre3nder_state_dir" || return 1
	ensure_private_directory "$fre3nder_ssh_dir"
}

prepare_hostkey() {
	if prepare_persistent_directory; then
		if [ "$hostkey_type" != ed25519 ]; then
			set_status persistent-hostkey-type-unsupported
			return 1
		fi
		hostkey=$fre3nder_ssh_dir/dropbear_ed25519_host_key
		if [ -e "$hostkey" ] || [ -L "$hostkey" ]; then
			[ -f "$hostkey" ] && [ ! -L "$hostkey" ] || {
				set_status persistent-hostkey-invalid
				return 1
			}
			return 0
		fi
		umask 077
		"$dropbearkey" -t "$hostkey_type" -f "$hostkey" >/dev/null || {
			set_status hostkey-generation-failed
			return 1
		}
		chmod 0600 "$hostkey" || {
			set_status persistent-hostkey-permissions-failed
			return 1
		}
		return 0
	fi

	"$dropbearkey" -t "$hostkey_type" -f "$hostkey" >/dev/null || {
		set_status hostkey-generation-failed
		return 1
	}
}

start() {
	enabled || {
		set_status disabled
		log 'disabled: valid authorized_keys and empty enable_ssh are both required'
		return 0
	}
	grep -Eq '^[^ ]+ /dev/pts devpts ' "$proc_mounts" || {
		set_status devpts-missing
		log 'disabled: devpts is not mounted'
		return 0
	}
	case "$hostkey_type" in
	ed25519|rsa|ecdsa) ;;
	*)
		set_status hostkey-type-unsupported
		log "disabled: unsupported host key type $hostkey_type"
		return 0
		;;
	esac
	[ -x "$dropbearkey" ] || {
		set_status dropbearkey-unavailable
		log "disabled: dropbearkey is unavailable at $dropbearkey"
		return 0
	}

	mkdir -p "$runtime" "$root_ssh" || {
		set_status runtime-setup-failed
		return 0
	}
	chmod 0700 "$runtime" "$root_ssh"
	install -m 0600 "$provisioning/authorized_keys" "$root_ssh/authorized_keys" || {
		set_status authorized-keys-copy-failed
		return 0
	}
	prepare_hostkey || return 0

	"$mount_cmd" -o bind "$root_ssh" /root/.ssh || {
		set_status authorized-keys-bind-failed
		return 0
	}
	"$dropbear" -r "$hostkey" -P "$pid_file" || {
		"$umount_cmd" /root/.ssh
		set_status server-start-failed
		return 0
	}
	set_status active
	if root_active && [ "$hostkey" = "$fre3nder_ssh_dir/dropbear_ed25519_host_key" ]; then
		log 'public-key-only SSH started with a persistent host key'
	else
		log 'public-key-only SSH started with a volatile host key'
	fi
}

stop() {
	if [ -r "$pid_file" ]; then
		pid=$(cat "$pid_file")
		case "$pid" in
		*[!0-9]*|'') ;;
		*) kill "$pid" 2>/dev/null || true ;;
		esac
		rm -f "$pid_file"
	fi
	if grep -Eq '^[^ ]+ /root/.ssh ' "$proc_mounts"; then
		"$umount_cmd" /root/.ssh || true
	fi
	rm -rf -- "$runtime"
}

case "${1:-}" in
start) start ;;
stop) stop ;;
restart) stop; start ;;
*) echo "usage: $0 {start|stop|restart}" >&2; exit 1 ;;
esac

exit 0
