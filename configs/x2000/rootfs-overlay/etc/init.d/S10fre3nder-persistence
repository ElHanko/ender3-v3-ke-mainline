#!/bin/sh

state=${FRE3NDER_PERSISTENCE_STATE:-/run/fre3nder-persistence}
persist_root=${FRE3NDER_PERSIST_ROOT:-/persist}
system_dir=$persist_root/system
userdata_dir=$persist_root/userdata
ssh_dir=$system_dir/fre3nder/ssh
firmware_dir=$system_dir/fre3nder/firmware/f005
log_dir=$userdata_dir/fre3nder/logs
status=$state/status
proc_mounts=${FRE3NDER_PROC_MOUNTS:-/proc/mounts}

set_status() {
	install -d -m 0700 "$state" 2>/dev/null || return 0
	printf '%s\n' "$1" > "$status" 2>/dev/null || true
}

valid_directory() {
	[ -d "$1" ] && [ ! -L "$1" ]
}

mounted_at() {
	awk -v target="$1" '$2 == target { found = 1 } END { exit !found }' \
		"$proc_mounts" 2>/dev/null
}

ensure_directory() {
	if [ ! -e "$1" ] && ! mkdir -m 0700 "$1"; then
		return 1
	fi
	valid_directory "$1"
}

start() {
	if ! valid_directory "$system_dir" || ! valid_directory "$userdata_dir" ||
		! mounted_at "$system_dir" || ! mounted_at "$userdata_dir"; then
		set_status missing-persistence
		return 0
	fi
	if ! ensure_directory "$system_dir/fre3nder" ||
		! ensure_directory "$ssh_dir" ||
		! ensure_directory "$system_dir/fre3nder/firmware" ||
		! ensure_directory "$firmware_dir" ||
		! ensure_directory "$userdata_dir/fre3nder" ||
		! ensure_directory "$log_dir"; then
		set_status system-layout-failed
		return 0
	fi
	set_status active
}

stop() {
	set_status stopped
}

case "${1:-}" in
start) start ;;
stop) stop ;;
restart) stop; start ;;
*) echo "usage: $0 {start|stop|restart}" >&2; exit 1 ;;
esac

exit 0
