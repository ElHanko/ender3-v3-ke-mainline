#!/bin/sh

state=${FRE3NDER_STATE:-/run/fre3nder}
runtime=$state/storage
mount_dir=$runtime/volume
status=$runtime/status
persist_root=${FRE3NDER_PERSIST_ROOT:-/persist}
system_dir=$persist_root/system
userdata_dir=$persist_root/userdata
dev_root=${FRE3NDER_DEV_ROOT:-/dev}
usb_devices=${FRE3NDER_USB_DEVICES:-}
blkid_cmd=${FRE3NDER_BLKID:-/sbin/blkid}
mount_cmd=${FRE3NDER_MOUNT:-mount}
umount_cmd=${FRE3NDER_UMOUNT:-umount}
wait_seconds=${FRE3NDER_STORAGE_WAIT_SECONDS:-10}
sleep_cmd=${FRE3NDER_SLEEP:-sleep}
mounted=false
system_bound=false
userdata_bound=false

log() {
	echo "fre3nder-x2000 storage: $*"
}

set_status() {
	printf '%s\n' "$1" > "$status" 2>/dev/null || true
}

cleanup() {
	if [ "$userdata_bound" = true ]; then
		"$umount_cmd" "$userdata_dir" 2>/dev/null || return 1
		userdata_bound=false
	fi
	if [ "$system_bound" = true ]; then
		"$umount_cmd" "$system_dir" 2>/dev/null || return 1
		system_bound=false
	fi
	if [ "$mounted" = true ]; then
		"$umount_cmd" "$mount_dir" 2>/dev/null || return 1
		mounted=false
	fi
}

is_usb_partition() {
	case "${1##*/}" in
	sd[a-z][0-9]*) return 0 ;;
	*) return 1 ;;
	esac
}

has_data_label() {
	output=$("$blkid_cmd" "$1" 2>/dev/null) || return 1
	case " $output " in
	*' LABEL="FRE3NDERDATA" '*) return 0 ;;
	*) return 1 ;;
	esac
}

scan_candidates() {
	candidates=0
	selected=
	if [ -n "$usb_devices" ]; then
		# Test-only override; production enumerates USB partitions below.
		# shellcheck disable=SC2086
		set -- $usb_devices
	else
		set -- "$dev_root"/sd[a-z][0-9]*
	fi
	for device; do
		is_usb_partition "$device" || continue
		[ -n "$usb_devices" ] || [ -b "$device" ] || continue
		if has_data_label "$device"; then
			candidates=$((candidates + 1))
			selected=$device
		fi
	done
}

valid_directory() {
	[ -d "$1" ] && [ ! -L "$1" ]
}

fail_with_cleanup() {
	if cleanup; then
		set_status "$1"
	else
		set_status cleanup-failed
	fi
	return 0
}

start() {
	install -d -m 0700 "$runtime" "$mount_dir" || return 1
	chmod 0700 "$state" "$runtime" "$mount_dir"
	waited=0
	scan_candidates
	while [ "$candidates" -eq 0 ] && [ "$waited" -lt "$wait_seconds" ]; do
		"$sleep_cmd" 1
		waited=$((waited + 1))
		scan_candidates
	done
	if [ "$candidates" -eq 0 ]; then
		set_status no-volume
		log 'no FRE3NDERDATA volume found'
		return 0
	fi
	if [ "$candidates" -ne 1 ]; then
		set_status multiple-volumes
		log 'multiple FRE3NDERDATA volumes found; refusing all'
		return 0
	fi
	if ! valid_directory "$system_dir" || ! valid_directory "$userdata_dir"; then
		set_status persist-path-invalid
		return 0
	fi
	if ! "$mount_cmd" -t ext4 -o rw,nosuid,nodev "$selected" "$mount_dir"; then
		set_status mount-failed
		return 0
	fi
	mounted=true
	if ! valid_directory "$mount_dir/p9" || ! valid_directory "$mount_dir/p10"; then
		log 'FRE3NDERDATA requires real p9 and p10 directories'
		fail_with_cleanup invalid-layout
		return 0
	fi
	if ! "$mount_cmd" -o bind "$mount_dir/p9" "$system_dir"; then
		fail_with_cleanup system-bind-failed
		return 0
	fi
	system_bound=true
	if ! "$mount_cmd" -o bind "$mount_dir/p10" "$userdata_dir"; then
		fail_with_cleanup userdata-bind-failed
		return 0
	fi
	userdata_bound=true
	set_status active
	log 'FRE3NDERDATA mapped to /persist'
}

stop() {
	case "$(cat "$status" 2>/dev/null)" in
	active|cleanup-failed)
		mounted=true
		system_bound=true
		userdata_bound=true
		if ! cleanup; then
			set_status cleanup-failed
			return 1
		fi
		;;
	esac
	set_status stopped
}

case "${1:-}" in
start) start ;;
stop) stop ;;
restart) stop; start ;;
*) echo "usage: $0 {start|stop|restart}" >&2; exit 1 ;;
esac

exit 0
